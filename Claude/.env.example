# Database (Postgres). `docker compose up -d` starts a local instance matching this default.
DATABASE_URL="postgresql://app:app@localhost:5432/marketing_video_tool"

# Local file storage (dev only — swapped for S3-compatible storage in production)
LOCAL_STORAGE_DIR=".storage"

# --- LLM (story refinement, scene breakdown) + Image generation (Nano Banana) ---
# Same key powers both the LLM provider and the image provider.
GEMINI_API_KEY=

# --- Video generation (Higgsfield proxies Kling/Veo/Sora/etc. behind one credential) ---
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# --- Voice / dialogue / narration ---
ELEVENLABS_API_KEY=

# --- Stock assets / licensed media ---
ENVATO_API_KEY=

# Every variable above is optional until its provider's build phase is
# reached (see ARCHITECTURE.md §9) — the app runs fully on mock providers
# with none of them set.
